{
  "name": "mcp-simple-server",
  "version": "0.1.0",
  "description": "Code Mode MCP server for Clever Cloud — exposes the full Clever Cloud API and documentation through three tools (search, execute, doc) using the @clevercloud/client command pattern",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Clever Cloud",
  "repository": {
    "type": "git",
    "url": "https://github.com/CleverCloud/mcp-simple-server"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "mcp-simple-server": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node -e \"process.getBuiltinModule('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "generate-catalog": "node scripts/generate-catalog.ts"
  },
  "dependencies": {
    "@clevercloud/client": "^12.6.7",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
